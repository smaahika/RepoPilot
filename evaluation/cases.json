        {"diagnosis": "The test expects ready, not running.", "next_step": "Replace running with ready."},
        {"tool_call": {"call_id": "correct", "tool_name": "write_patch", "arguments": {"patch": "diff --git a/status.py b/status.py\n--- a/status.py\n+++ b/status.py\n@@ -1,2 +1,2 @@\n def status() -> str:\n-    return \"running\"\n+    return \"ready\"\n"}}}
      ],
      "expected": {
