{
  "schema_version": 1,
  "name": "offline_replay_v1",
  "cases": [
    {
      "id": "update_greeting",
      "task": "Change greeting() to return hello RepoPilot.",
      "files": [
        {
          "path": "greeting.py",
          "content": "def greeting() -> str:\n    return \"hello\"\n"
        },
        {
          "path": "test_greeting.py",
          "content": "from greeting import greeting\n\n\ndef test_greeting() -> None:\n    assert greeting() == \"hello RepoPilot\"\n"
        }
      ],
      "verification": {"argv": ["pytest", "-q", "-p", "no:cacheprovider"], "timeout_seconds": 30},
      "scripted_responses": [
        {
          "summary": "Update the greeting and verify it.",
          "steps": [{"id": "update", "objective": "Change greeting().", "files": ["greeting.py"], "verification": ["pytest -q"]}],
          "assumptions": []
        },
        {"tool_call": {"call_id": "read", "tool_name": "read_file", "arguments": {"path": "greeting.py"}}},
        {"tool_call": {"call_id": "patch", "tool_name": "write_patch", "arguments": {"patch": "diff --git a/greeting.py b/greeting.py\n--- a/greeting.py\n+++ b/greeting.py\n@@ -1,2 +1,2 @@\n def greeting() -> str:\n-    return \"hello\"\n+    return \"hello RepoPilot\"\n"}}}
      ],
      "expected": {
        "termination_reason": "success",
        "changed_files": ["greeting.py"],
        "verification_statuses": ["passed"],
        "patch_contains": ["+    return \"hello RepoPilot\""],
        "patch_excludes": ["+    return \"hello\""]
      }
    },
    {
      "id": "fix_double",
      "task": "Fix double() so it returns twice the supplied integer.",
      "files": [
        {"path": "calc.py", "content": "def double(value: int) -> int:\n    return value\n"},
        {"path": "test_calc.py", "content": "from calc import double\n\n\ndef test_double() -> None:\n    assert double(4) == 8\n"}
      ],
      "verification": {"argv": ["pytest", "-q", "-p", "no:cacheprovider"], "timeout_seconds": 30},
      "scripted_responses": [
        {
          "summary": "Correct the arithmetic implementation.",
          "steps": [{"id": "fix", "objective": "Multiply the input by two.", "files": ["calc.py"], "verification": ["pytest -q"]}],
          "assumptions": []
        },
        {"tool_call": {"call_id": "read", "tool_name": "read_file", "arguments": {"path": "calc.py"}}},
        {"tool_call": {"call_id": "patch", "tool_name": "write_patch", "arguments": {"patch": "diff --git a/calc.py b/calc.py\n--- a/calc.py\n+++ b/calc.py\n@@ -1,2 +1,2 @@\n def double(value: int) -> int:\n-    return value\n+    return value * 2\n"}}}
      ],
      "expected": {
        "termination_reason": "success",
        "changed_files": ["calc.py"],
        "verification_statuses": ["passed"],
        "patch_contains": ["+    return value * 2"]
      }
    },
    {
      "id": "implement_slugify",
      "task": "Implement slugify() using lowercase words joined by hyphens.",
      "files": [
        {"path": "text.py", "content": "def slugify(value: str) -> str:\n    raise NotImplementedError\n"},
        {"path": "test_text.py", "content": "from text import slugify\n\n\ndef test_slugify() -> None:\n    assert slugify(\"Hello Repo Pilot\") == \"hello-repo-pilot\"\n"}
      ],
      "verification": {"argv": ["pytest", "-q", "-p", "no:cacheprovider"], "timeout_seconds": 30},
      "scripted_responses": [
        {
          "summary": "Implement the missing text transformation.",
          "steps": [{"id": "implement", "objective": "Normalize and join words.", "files": ["text.py"], "verification": ["pytest -q"]}],
          "assumptions": ["Whitespace separates words."]
        },
        {"tool_call": {"call_id": "read", "tool_name": "read_file", "arguments": {"path": "text.py"}}},
        {"tool_call": {"call_id": "patch", "tool_name": "write_patch", "arguments": {"patch": "diff --git a/text.py b/text.py\n--- a/text.py\n+++ b/text.py\n@@ -1,2 +1,2 @@\n def slugify(value: str) -> str:\n-    raise NotImplementedError\n+    return \"-\".join(value.lower().split())\n"}}}
      ],
      "expected": {
        "termination_reason": "success",
        "changed_files": ["text.py"],
        "verification_statuses": ["passed"],
        "patch_contains": ["+    return \"-\".join(value.lower().split())"]
      }
    },
